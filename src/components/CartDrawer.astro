---
---

<button id="cart-fab" class="cart-fab" aria-label="Ver tu lista">
  <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M2 2h3l2.5 11h9L19 6H6" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter" fill="none"/>
    <circle cx="9.5" cy="19" r="1.5" fill="currentColor"/>
    <circle cx="16.5" cy="19" r="1.5" fill="currentColor"/>
  </svg>
  <span id="cart-badge" class="cart-badge">0</span>
</button>

<div id="cart-drawer" class="cart-drawer" aria-hidden="true">
  <div class="cart-drawer__header">
    <span class="cart-drawer__title">Tu lista</span>
    <button id="cart-close" class="cart-close" aria-label="Cerrar">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <line x1="2" y1="2" x2="18" y2="18" stroke="currentColor" stroke-width="3" stroke-linecap="square"/>
        <line x1="18" y1="2" x2="2" y2="18" stroke="currentColor" stroke-width="3" stroke-linecap="square"/>
      </svg>
    </button>
  </div>
  <div id="cart-body" class="cart-drawer__body"></div>
  <div id="cart-footer" class="cart-drawer__footer">
    <a id="cart-whatsapp" class="cart-whatsapp" href="#" target="_blank" rel="noopener noreferrer">
      Consultar por WhatsApp
    </a>
  </div>
</div>

<div id="cart-backdrop" class="cart-backdrop"></div>

<style>
  .cart-fab {
    position: fixed;
    bottom: 60px;
    right: 24px;
    z-index: 100;
    width: 54px;
    height: 54px;
    background: var(--bg);
    border: var(--border);
    box-shadow: var(--shadow-lime);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.1s, box-shadow 0.1s;
  }

  .cart-fab:hover {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0px var(--accent);
  }

  .cart-fab:active {
    transform: translate(3px, 3px);
    box-shadow: 3px 3px 0px var(--accent);
  }

  .cart-badge {
    position: absolute;
    top: -10px;
    right: -10px;
    width: 22px;
    height: 22px;
    border-radius: 0;
    background: var(--accent);
    border: 2px solid #000;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    display: none;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: min(400px, 100vw);
    height: 100%;
    z-index: 300;
    background: var(--bg);
    border-left: var(--border);
    box-shadow: -8px 0 0 0 var(--accent);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .cart-drawer.is-open {
    transform: translateX(0);
  }

  .cart-backdrop {
    position: fixed;
    inset: 0;
    z-index: 299;
    display: none;
  }

  .cart-backdrop.is-active {
    display: block;
  }

  .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: var(--border);
    flex-shrink: 0;
  }

  .cart-drawer__title {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 3vw, 1.5rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .cart-close {
    width: 44px;
    height: 44px;
    background: transparent;
    border: var(--border);
    box-shadow: var(--shadow-lime);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.1s, box-shadow 0.1s;
    flex-shrink: 0;
  }

  .cart-close:hover {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0px var(--accent);
  }

  .cart-close:active {
    transform: translate(3px, 3px);
    box-shadow: 3px 3px 0px var(--accent);
  }

  .cart-drawer__body {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* cart-item styles are in <style is:global> below — dynamically created elements need global scope */

  .cart-drawer__footer {
    padding: 1.25rem 1.5rem;
    border-top: var(--border);
    flex-shrink: 0;
    display: none;
  }

  .cart-drawer__footer.is-visible {
    display: block;
  }

  .cart-whatsapp {
    display: block;
    width: 100%;
    background: var(--accent);
    border: var(--border);
    box-shadow: 6px 6px 0px #000;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 14px 28px;
    text-align: center;
    text-decoration: none;
    color: #000;
    cursor: pointer;
    transition: transform 0.1s, box-shadow 0.1s;
  }

  .cart-whatsapp:hover {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0px #000;
  }

  .cart-whatsapp:active {
    transform: translate(3px, 3px);
    box-shadow: 3px 3px 0px #000;
  }
</style>

<style is:global>
  .cart-empty {
    margin: auto;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    opacity: 0.5;
    text-align: center;
  }

  .cart-item {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    gap: 0.75rem;
    align-items: center;
    border: var(--border);
    box-shadow: 4px 4px 0px var(--accent);
    padding: 0.5rem;
    background: var(--bg);
  }

  .cart-item__thumb {
    width: 80px;
    height: 60px;
    background: #e8e3da;
    border: 2px solid #000;
    overflow: hidden;
    flex-shrink: 0;
  }

  .cart-item__thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 4px;
    display: block;
  }

  .cart-item__name {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .cart-item__remove {
    width: 32px;
    height: 32px;
    background: transparent;
    border: 2px solid #000;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.1s, color 0.1s;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    font-family: var(--font-body);
  }

  .cart-item__remove:hover {
    background: #ff3333;
    color: white;
  }
</style>

<script>
  import { getCart, removeFromCart } from "../data/cart";
  import itemsData from "../data/items.json";
  import { WHATSAPP_NUMBER } from "../config";

  type ItemEntry = { id: string; name: string; image: string; sold: boolean };

  const fab = document.getElementById("cart-fab")!;
  const badge = document.getElementById("cart-badge")!;
  const drawer = document.getElementById("cart-drawer")!;
  const closeBtn = document.getElementById("cart-close")!;
  const body = document.getElementById("cart-body")!;
  const footer = document.getElementById("cart-footer")!;
  const whatsappLink = document.getElementById("cart-whatsapp") as HTMLAnchorElement;
  const backdrop = document.getElementById("cart-backdrop")!;

  function buildCartItem(item: ItemEntry): HTMLElement {
    const el = document.createElement("div");
    el.className = "cart-item";
    const rawSrc = item.image.replace("/images/", "/raw-images/");
    el.innerHTML = `
      <div class="cart-item__thumb">
        <img src="${item.image}" alt="${item.name}" onerror="this.onerror=null;this.src='${rawSrc}'" />
      </div>
      <span class="cart-item__name">${item.name}</span>
      <button class="cart-item__remove" data-remove-id="${item.id}" aria-label="Quitar ${item.name}">✕</button>
    `;
    return el;
  }

  function updateDrawer() {
    const cart = getCart();

    badge.style.display = cart.length > 0 ? "flex" : "none";
    badge.textContent = String(cart.length);

    body.innerHTML = "";

    if (cart.length === 0) {
      const empty = document.createElement("div");
      empty.className = "cart-empty";
      empty.textContent = "Tu lista está vacía";
      body.appendChild(empty);
      footer.classList.remove("is-visible");
    } else {
      const cartItems = cart
        .map((id) => (itemsData as ItemEntry[]).find((item) => item.id === id))
        .filter((item): item is ItemEntry => item !== undefined);

      cartItems.forEach((item) => body.appendChild(buildCartItem(item)));

      const lines = cartItems.map((i) => `- ${i.name}`).join("\n");
      const message = `Hola! Vi tu venta y me interesan algunos artículos:\n${lines}\n¿Están disponibles?`;
      whatsappLink.href = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
      footer.classList.add("is-visible");
    }
  }

  function openDrawer() {
    drawer.classList.add("is-open");
    backdrop.classList.add("is-active");
    drawer.setAttribute("aria-hidden", "false");
  }

  function closeDrawer() {
    drawer.classList.remove("is-open");
    backdrop.classList.remove("is-active");
    drawer.setAttribute("aria-hidden", "true");
  }

  fab.addEventListener("click", openDrawer);
  closeBtn.addEventListener("click", closeDrawer);
  backdrop.addEventListener("click", closeDrawer);

  body.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-remove-id]");
    if (!btn) return;
    removeFromCart(btn.dataset.removeId!);
  });

  window.addEventListener("cart:updated", () => updateDrawer());

  updateDrawer();
</script>
