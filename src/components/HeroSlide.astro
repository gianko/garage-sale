---
import MarqueeStrip from "./MarqueeStrip.astro";
import { SALE_LOCATION, SALE_DATE } from "../config";
import items from "../data/items.json";

const availableCount = items.filter((i) => !i.sold).length;
const eyebrow = `${SALE_LOCATION} · ${SALE_DATE}`;

const heroWords = [
  "Me estoy mudando",
  "Vendo todo",
  "Precios insuperables",
  "Solo recogida",
  SALE_LOCATION,
  SALE_DATE,
  "Todo tiene que irse",
  "Sin intermediarios",
];
const itemWords = [
  "Buen estado (ponele)",
  "Solo recogida en mano",
  "Sin envío",
  "Primero en llegar",
  "Sin reservas",
];
---

<section class="hero">
  <p class="hero__eyebrow">{eyebrow}</p>
  <h1 class="hero__title">
    Me mudo<br />
    y <em>vendo</em><br />todo
  </h1>
  <p class="hero__subtitle">
    {availableCount} artículos disponibles · Precios sin regateo
  </p>
  <div class="hero__marquees">
    <MarqueeStrip words={heroWords} />
    <MarqueeStrip words={itemWords} reverse small />
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    text-align: center;
    background: var(--bg);
  }

  .hero__eyebrow {
    font-family: var(--font-body);
    font-size: clamp(11px, 1.4vw, 15px);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--black);
    margin-bottom: 2rem;
    opacity: 0.5;
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 9vw, 11rem);
    font-weight: 900;
    line-height: 0.9;
    color: var(--black);
    text-transform: uppercase;
    letter-spacing: -0.03em;
    text-wrap: balance;
    max-width: 16ch;
  }

  .hero__title em {
    font-style: normal;
    color: var(--black);
    position: relative;
    display: inline-block;
    isolation: isolate;
  }

  .hero__title em::after {
    content: "";
    position: absolute;
    bottom: 0.06em;
    left: 0;
    right: 0;
    height: 0.14em;
    background: var(--accent);
    z-index: -1;
  }

  .hero__subtitle {
    font-family: var(--font-body);
    font-size: clamp(13px, 1.5vw, 18px);
    font-weight: 500;
    color: var(--black);
    margin-top: 2.5rem;
    opacity: 0.7;
    letter-spacing: 0.02em;
  }

  .hero__marquees {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
  }
</style>
