---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSlide from "../components/HeroSlide.astro";
import ItemSlide from "../components/ItemSlide.astro";
import ThumbnailGrid from "../components/ThumbnailGrid.astro";
import items from "../data/items.json";
---

<BaseLayout>
  <div id="slides-wrapper">
    <div id="slides-container">
      <HeroSlide />
      {
        items.map((item, i) => (
          <ItemSlide item={item} index={i} total={items.length} />
        ))
      }
    </div>
  </div>
  <ThumbnailGrid items={items} />
</BaseLayout>

<style is:global>
  html,
  body {
    height: 100%;
    overflow: hidden;
  }

  #slides-container > * {
    scroll-snap-align: start;
  }
</style>

<style>
  #slides-wrapper {
    height: 100vh;
    overflow-y: scroll;
    scroll-snap-type: y mandatory;
    scrollbar-width: none;
  }

  #slides-wrapper::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  import itemsData from "../data/items.json";

  const slides = Array.from(
    document.querySelectorAll("#slides-container > section")
  ) as HTMLElement[];
  let current = 0;

  // keep current in sync when user scrolls naturally
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) current = slides.indexOf(e.target as HTMLElement);
      });
    },
    { threshold: 0.5 }
  );
  slides.forEach((s) => io.observe(s));

  function goTo(index: number) {
    if (index < 0 || index >= slides.length) return;
    current = index;
    slides[index].scrollIntoView({ behavior: "smooth" });
  }

  // thumbnail grid navigation: resolve item id → slide index (slides[0] = hero)
  window.addEventListener("thumb:navigate", (e: Event) => {
    const { itemId } = (e as CustomEvent<{ itemId: string }>).detail;
    const itemIndex = itemsData.findIndex((item) => item.id === itemId);
    if (itemIndex !== -1) goTo(itemIndex + 1);
  });

  window.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") goTo(current + 1);
    if (e.key === "ArrowUp") goTo(current - 1);
  });
</script>
